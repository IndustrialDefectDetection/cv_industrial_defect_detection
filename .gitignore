# Secrets. .env holds a real ANTHROPIC_API_KEY and a database password -
# copy .env.example instead. Ignored everywhere, not just at the root,
# because each sub-project boots from its own .env.
.env
**/.env
!**/.env.example

# Python bytecode
__pycache__/
*.py[cod]

# Virtualenvs. venv writes a self-ignoring .gitignore of its own, but that is
# a side effect to rely on rather than a rule.
.venv/

# Generated incident reports can contain operational and personnel details.
sample-MES-ClosedLoop-Strands-Agent/reports/*.pdf
sample-MES-ClosedLoop-Strands-Agent/reports/.private/

# Agent-generated operational summaries and scheduler logs.
industrial-data-store-simulation-chatbot/reports/daily_analysis/
industrial-data-store-simulation-chatbot/logs/
