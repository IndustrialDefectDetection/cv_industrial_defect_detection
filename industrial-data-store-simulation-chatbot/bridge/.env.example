# PostgreSQL connection for the bridge.
# Copy this file to .env, keep that file out of Git, and fill in real values.
#
# These sample values target PostgreSQL on this machine only. For any remote
# database, set its host/user/password, keep MES_PG_SSLMODE=verify-full, and
# provide the CA certificate path when your libpq installation needs one.
MES_PG_HOST=127.0.0.1
MES_PG_PORT=5432
MES_PG_DBNAME=mescopy_v1
MES_PG_USER=postgres
MES_PG_PASSWORD=
MES_PG_SSLMODE=disable
MES_PG_SSLROOTCERT=
MES_PG_CONNECT_TIMEOUT=10
MES_PG_STATEMENT_TIMEOUT_MS=15000
MES_PG_LOCK_TIMEOUT_MS=3000

# Use the same generated 32+ character value in the simulator, bridge,
# inference API, agent API, trace viewer, and frontend server.
MES_INTERNAL_API_TOKEN=

# These values may be lowered, but code-enforced ceilings keep the bridge at
# 1 MiB/request, 32 active windows, and 500 detections/window.
MES_BRIDGE_MAX_REQUEST_BYTES=1048576
MES_MAX_BATCH_WINDOWS=32
MES_MAX_DETECTIONS_PER_WINDOW=500
