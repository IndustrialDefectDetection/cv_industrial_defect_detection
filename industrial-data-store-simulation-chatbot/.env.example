# Bedrock uses static environment credentials only. Copy this file to .env,
# run `chmod 600 .env`, keep it out of Git, and supply an IAM access key with
# least privilege. The application rejects symlinked or group/world-accessible
# .env files rather than loading secrets from them.
#
# AWS profiles, assume-role, web identity, SSO, credential_process, ECS task
# credentials, and EC2 instance metadata are intentionally not used. This
# prevents credential-provider traffic from being redirected by ambient
# endpoint or proxy settings.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary static credentials:
AWS_SESSION_TOKEN=
