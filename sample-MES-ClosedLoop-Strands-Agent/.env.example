# Copy to .env and fill in your key:  cp .env.example .env
# .env is gitignored and must never be committed - it holds a real API key.
# startup.py will prompt for the key and validate it if .env is missing.

# ---- Credentials ----------------------------------------------------------
ANTHROPIC_API_KEY=PASTE_YOUR_KEY_HERE

# ---- Model ----------------------------------------------------------------
MES_MODEL_ID=claude-haiku-4-5-20251001
# A cap, not a target. 4096 was too low for the Planner, which emits a whole
# report as a tool argument and hit the output limit mid-call.
MES_MAX_TOKENS=16384
MES_TEMPERATURE=0.2

# ---- API client -----------------------------------------------------------
# Seconds before a single request is abandoned. Without it the SDK waits 10
# minutes and a stalled request looks like a frozen run.
MES_API_TIMEOUT=120
MES_API_RETRIES=2

# ---- Agent reliability ----------------------------------------------------
# Tries per agent before it is reported unavailable (clamped to 5). The usual
# trigger is the output token limit, where an attempt continues the partial
# reply rather than redoing it - so a third can finish a long report.
MES_AGENT_MAX_ATTEMPTS=3

# ---- Chat -----------------------------------------------------------------
# Supervisor delegations allowed per chat question (clamped to 3). Each one is
# a full multi-agent workflow costing minutes and real credit, so one question
# earns one analysis; anything more should be a follow-up the user asks for.
MES_CHAT_SUPERVISOR_CALLS=1
# Chat keeps its history so follow-ups work, but not without bound.
MES_CHAT_HISTORY_MESSAGES=12

# ---- Database -------------------------------------------------------------
# postgres is the default: the CV pipeline writes detections there, so an
# agent left on sqlite would look in the wrong place and find no defects.
MES_DB_BACKEND=postgres
# Local-only sample. Remote databases must set their own host/user/password,
# use verify-full TLS, and point at a trusted CA certificate when required.
MES_PG_HOST=127.0.0.1
MES_PG_PORT=5432
MES_PG_DBNAME=mescopy_v1
MES_PG_USER=postgres
MES_PG_PASSWORD=
MES_PG_SSLMODE=disable
MES_PG_SSLROOTCERT=
MES_PG_CONNECT_TIMEOUT=10
MES_PG_STATEMENT_TIMEOUT_MS=15000
MES_PG_LOCK_TIMEOUT_MS=3000

# Generated automatically by startup.py when absent. If Launch.py supplies a
# token, startup.py persists that same value so every local service agrees.
MES_INTERNAL_API_TOKEN=
# Process-wide rolling cap for cost-bearing chat/analysis/investigation starts.
MES_MAX_RUNS_PER_HOUR=10

# ---- Email ----------------------------------------------------------------
# Live SES delivery is disabled unless this is explicitly set to true.
# Only the configured sender and recipient are used; model output cannot pick
# arbitrary recipients.
MES_EMAIL_ENABLED=false
# When live SES delivery is enabled, only static environment credentials are
# accepted. Profiles, assume-role, web identity, SSO, credential_process, ECS,
# and EC2 instance-metadata credentials are intentionally not consulted.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary static credentials:
AWS_SESSION_TOKEN=
