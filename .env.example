# Values Launch.py hands to the services it starts.
#
# Copy to .env at the repo root (it is gitignored). On Linux and macOS also run
# `chmod 600 .env` - the launcher refuses to read a file other users can read.
#
# Each name is passed only to the services allowed to see it, per the
# allowlists in Launch.py. Anything already set in your shell wins over this
# file, so a one-off `MES_MODEL_ID=... python Launch.py` still works.
#
# The frontend depends on this file specifically. Next.js is started through
# frontend/scripts/run-next-secure.mjs, which refuses to run on Windows if any
# .env file exists inside frontend/ - it cannot verify that file's permissions
# there - and asks for the values through the process environment instead.
# This is that process environment.

# --- Agents (backend, trace viewer) ---
ANTHROPIC_API_KEY=
MES_MODEL_ID=claude-haiku-4-5-20251001
# Hourly cap on paid agent runs. Clamped to 1-100; default 10.
MES_MAX_RUNS_PER_HOUR=10

# --- Database (PostgreSQL) ---
# Every service reads and writes this one database. The defaults below are what
# the code already assumes for a local install, so in practice the password is
# the only line you have to fill in - but a local PostgreSQL configured with
# scram-sha-256 (the installer default) will refuse the connection without it,
# and the service that fails looks like a missing table rather than a missing
# password. Set it.
MES_DB_BACKEND=postgres
MES_PG_HOST=127.0.0.1
MES_PG_PORT=5432
MES_PG_DBNAME=mescopy_v1
MES_PG_USER=postgres
MES_PG_PASSWORD=

# --- Shared loopback authentication ---
# One high-entropy value of at least 32 characters, shared by every local
# service. Leave blank and Launch.py generates one for the run.
MES_INTERNAL_API_TOKEN=

# --- Frontend (Next.js) ---
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BACKEND_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/mescopy_v1
AUTH_ALLOW_EMAIL_SIGNUP=true
AUTH_ALLOW_GOOGLE_SIGNUP=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Camera and bridge ---
# MODEL_PATH only overrides where best.pt is found. Leave it commented out to
# use the trained weights in steel-defect-detection-mlops/runs/... - an empty
# assignment is a value, and would be read as a path.
# MODEL_PATH=
MES_AGENT_URL=http://127.0.0.1:8000
