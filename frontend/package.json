{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:migrate": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate-database.mjs",
    "dev": "node scripts/run-next-secure.mjs dev",
    "build": "node scripts/run-next-secure.mjs build",
    "start": "node scripts/run-next-secure.mjs start",
    "lint": "eslint",
    "test:security": "node --test --experimental-strip-types tests/*.test.mts"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
