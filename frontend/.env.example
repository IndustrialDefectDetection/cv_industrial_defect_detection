# Public origin of this Next.js app. Use HTTPS outside localhost.
# Copy this file to .env.local, then run `chmod 600 .env.local` before startup.
BETTER_AUTH_URL=http://localhost:3000

# Generate a unique value of at least 32 characters.
BETTER_AUTH_SECRET=replace-me

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Email/password registration is enabled by default. Set this to false to
# close new email registration without affecting existing accounts.
AUTH_ALLOW_EMAIL_SIGNUP=true

# Google account registration is enabled by default. Set this to false to
# allow only existing linked Google accounts to sign in.
AUTH_ALLOW_GOOGLE_SIGNUP=true

# Required when BETTER_AUTH_URL is not loopback. Configure the reverse proxy to
# remove client-supplied X-Mes-* headers, inject this secret, overwrite
# X-Mes-Client-Ip with one validated client IP, and keep the Next.js origin
# unreachable except through that proxy.
# AUTH_TRUSTED_PROXY_SECRET=replace-with-a-unique-32-character-secret

DATABASE_URL=postgresql://user:password@127.0.0.1:5432/database

# The Supabase Root 2021 CA is bundled in certs/supabase-root-2021.crt.
# Set DATABASE_CA_CERT only to override that default during certificate
# rotation or when using another database provider. Encode newlines as \n.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# The MES service may use HTTP only when it runs on this machine.
BACKEND_URL=http://127.0.0.1:8000

# Generate one random value of at least 32 characters and configure the exact
# same value in the MES backend.
MES_INTERNAL_API_TOKEN=
