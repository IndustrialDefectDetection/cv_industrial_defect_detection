# Steel Defect Detection MLOps - Environment Variables

# API Configuration
PORT=8080
HOST=127.0.0.1
ENVIRONMENT=production

# Required service credentials (leave blank here; generate unique local values)
# openssl rand -hex 32
MES_INTERNAL_API_TOKEN=
# openssl rand -base64 32
GRAFANA_ADMIN_PASSWORD=
# Used to encrypt credentials stored by Grafana; keep stable after first start.
# openssl rand -hex 32
GRAFANA_SECRET_KEY=
GRAFANA_ADMIN_USER=admin

# Model Configuration
MODEL_PATH=runs/detect/steel_defect_colab_50_epochs/weights/best.pt
# The application refuses to deserialize model bytes that do not match this
# reviewed artifact. Update deliberately when retraining.
MODEL_SHA256=de5c11747b2b85554b06c570dae9e50a1e8883c75db93d2eb7396895868d3a3e

# Inference request limits
MES_MAX_IMAGE_BYTES=10485760
MES_MAX_IMAGE_PIXELS=16000000
MES_MAX_BATCH_FILES=16
MES_MAX_BATCH_BYTES=33554432
MES_INFERENCE_CONCURRENCY=1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Health Check
HEALTH_CHECK_TIMEOUT=30
